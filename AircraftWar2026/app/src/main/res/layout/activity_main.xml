<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <TextView
            style="@style/Widget.AircraftWar.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/menu_title" />

        <FrameLayout
            android:id="@+id/menu_art"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_art_height"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/panel"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:contentDescription="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.72"
                android:scaleType="centerCrop"
                android:src="@drawable/background_normal" />

            <ImageView
                android:contentDescription="@null"
                android:layout_width="@dimen/menu_hero_size"
                android:layout_height="@dimen/menu_hero_size"
                android:layout_gravity="center"
                android:src="@drawable/hero" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                style="@style/Widget.AircraftWar.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/select_difficulty" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/play_easy"
                    style="@style/Widget.AircraftWar.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/difficulty_easy" />

                <Button
                    android:id="@+id/play_normal"
                    style="@style/Widget.AircraftWar.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:text="@string/difficulty_normal" />

                <Button
                    android:id="@+id/play_hard"
                    style="@style/Widget.AircraftWar.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:text="@string/difficulty_hard" />
            </LinearLayout>
        </LinearLayout>

        <Switch
            android:id="@+id/music_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/panel"
            android:minHeight="@dimen/touch_target"
            android:paddingHorizontal="@dimen/space_16"
            android:text="@string/music_switch"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
        <Button
            android:id="@+id/show_ranking"
            style="@style/Widget.AircraftWar.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/rank_title" />
    </LinearLayout>
</ScrollView>
